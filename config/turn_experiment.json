{
  "schema": "head_rgbd.turn_experiment.config.v1",
  "note": "Independent experiment configuration: one frontal RGB-D anchor plus a continuous closed-mouth head-turn RGB-D sequence. Nothing here changes config/defaults.json or the production chain.",
  "experiment": {
    "name": "front_anchor_turn_rgbd",
    "version": "0.1.0",
    "device": "cuda",
    "seed": 20261102,
    "output_root_name": "turn_experiment",
    "output_suffix": "turn"
  },
  "flame": {
    "shape_components": 50,
    "expression_components": 10
  },
  "input": {
    "max_adjacent_gap_s": 0.2,
    "allow_unverified_alignment": false,
    "min_source_frames": 3,
    "min_anchor_frames": 1
  },
  "tracking": {
    "detect_stride": 3,
    "klt_window": 21,
    "klt_levels": 3,
    "klt_min_landmarks": 40,
    "klt_forward_backward_px": 1.0,
    "max_yaw_jump_deg": 18.0,
    "max_pitch_deg": 28.0,
    "max_roll_deg": 22.0,
    "max_fit_residual_mm": 8.0,
    "min_valid_upper_landmarks": 8,
    "expression_gap_mm": 2.5,
    "expression_ratio": 0.045,
    "quality": {
      "min_sharpness": 40.0,
      "reference_sharpness": 180.0,
      "min_face_depth_pixels": 200,
      "reference_face_depth_pixels": 2600,
      "min_valid_landmarks": 24,
      "reference_residual_mm": 1.0,
      "max_residual_mm": 8.0
    }
  },
  "keyframes": {
    "max_keyframes": 9,
    "anchor_budget": 1,
    "repeat_observations_per_angle": 2,
    "repeat_max_angle_delta_deg": 6.0,
    "front_yaw_deg": 8.0,
    "anchor_max_yaw_deg": 15.0,
    "angle_bin_deg": 10.0,
    "min_yaw_separation_deg": 6.0,
    "max_yaw_deg": 55.0,
    "min_quality": 0.25,
    "min_selection_score": 0.2,
    "surface_gain_weight": 0.5,
    "side_balance_bonus": 0.15
  },
  "front_init": {
    "steps": 240,
    "points_per_frame": 1200
  },
  "joint_shape": {
    "pose_steps": 60,
    "joint_steps": 180,
    "points_per_frame": 1200,
    "correspondence_interval": 10,
    "landmark_visibility_mm": 0.012,
    "expression_prior_weight": 0.05,
    "jaw_delta_prior_weight": 0.05,
    "expression_bound": 0.8,
    "jaw_delta_bound_rad": 0.10,
    "anchor_shape_prior": 0.02,
    "max_correspondence_depth_mm": 8.0,
    "max_correspondence_plane_mm": 5.0,
    "min_correspondences": 30
  },
  "pose_correction": {
    "steps": 60
  },
  "field": {
    "solver": "qp",
    "points_per_frame": 5000,
    "outer_steps": 2,
    "gradient_length_mm": 8.0,
    "bending_length_mm": 8.0,
    "low_bending_length_mm": 8.0,
    "displacement_bound_mm": 2.5,
    "maximum_slope": 0.45,
    "maximum_normal_change_deg": 35.0,
    "minimum_signed_area_ratio": 0.05,
    "noise_floor_mm": 0.28867513459481287,
    "research_v2": true,
    "fixed_ray_policy": "strict-coverage",
    "support_min_information": 0.5,
    "coverage_allowance_ratio": 0.001,
    "information_measure": "barycentric",
    "information_damping_cap": 10.0,
    "view_balance": true,
    "loop_target_blend": 0.5,
    "probe_points_per_frame": 1500,
    "probe_max_depth_mm": 30.0
  },
  "delivery": {
    "keep_stage_directories": true,
    "metrics_to_watch": [
      "reconstruction_elapsed_s",
      "per_view_depth_consistency_mm",
      "side_geometry_change_mm",
      "surface_smoothness_mm_per_mm"
    ]
  }
}
